# Port. Render/Railway/Azure/AWS inject their own PORT automatically; 4000 is only the local default.
PORT=4000

# Frontend origin(s) allowed by CORS. Comma-separated to allow several (e.g. production + preview).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Database.
# Local docker-compose:  postgresql://app:app@localhost:5432/app
# Supabase: use the "Session pooler" string from Connect -> (port 5432, user "postgres.<project-ref>").
#   Do NOT use the "Direct connection" string on Render/Railway: it is IPv6-only and will fail to connect.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Object storage (Amazon S3 or Cloudflare R2). Optional: only needed once you upload scans/photos.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Optional AI services (segmentation, generative layout, embeddings, lighting).
# Left empty, each one falls back (local RANSAC, built-in layout engine, neutral lighting).
AI_API_KEY=
AI_SEGMENTATION_URL=
AI_LAYOUT_URL=
AI_EMBEDDINGS_URL=
AI_LIGHTING_URL=

# OpenRouter — the left-side AI chat. Without a key the chat answers with a clear "not configured" error.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OmniRoute — local OpenAI-compatible gateway. Put the admin key in .env (never commit it).
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# Model or combo name configured in OmniRoute (required for the AI layout).
OMNIROUTE_MODEL=

# Session tokens (POST /api/v1/auth/login). Set a long random value in production;
# with ENVIRONMENT=production the FastAPI server refuses to start without it. In development an empty
# value generates a random key on every start, so earlier tokens become invalid.
# Changing it logs every user out.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# FastAPI backend (app/). "production" on Render.
ENVIRONMENT=development
# Frontend origins allowed by CORS in the FastAPI backend, comma-separated, no trailing slash.
# Production: https://your-app.vercel.app   (FRONTEND_URL above is only read by the old Node server).
ALLOWED_ORIGINS=http://localhost:3000
# Registers GET /api/v1/spaces/debug-vars. Leave unset in production.
ENABLE_DEBUG_ROUTES=false
# Most furniture pieces one account may keep in its catalog (POST /catalog answers 409 beyond it).
MAX_CATALOG_ITEMS_PER_USER=300
# Calls to the AI model per account (chat, catalog, analyze, analyze-photo); 429 beyond them.
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=200
# Failed logins allowed per email within the window; then 429.
LOGIN_FAILURES_PER_EMAIL=10
LOGIN_FAILURE_WINDOW_MINUTES=15
